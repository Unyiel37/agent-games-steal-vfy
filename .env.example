# Copy this file to .env and fill in the values. Never commit .env.
# The HMAC secret comes from the Agent Games dashboard (Rotate Secret) —
# a FRESH secret for the Steal the VFY agent (do NOT reuse the
# Proof Gatekeeper secret).

# HTTP port the agent listens on
PORT=3000

# Platform-issued HMAC secret (required) — from the dashboard "Rotate Secret"
# for the Steal the VFY agent
AGENT_GAMES_HMAC_SECRET_VFY=<redacted>

# Groth16 circuit artifacts (downloaded from the official Agent Games
# build guide, artifacts section — not committed to this repo)
CIRCUIT_WASM_PATH=./circuits/vfy-policy.wasm
CIRCUIT_ZKEY_PATH=./circuits/vfy-policy_final.zkey

# Verification-key hash of the vfy-policy circuit, registered on
# zkVerify mainnet
REGISTERED_VK_HASH=0x6c56509f1c56fd1fd4e9737f906d2220f4b95f1d507f1adf6899085bd74be047

# Circuit version bound into every policy proof (must match the
# strategy commitment registered in the dashboard)
CIRCUIT_VERSION=1

# Strategy parameters (8 private field elements) for the v1 strategy.
# The commitment registered in the dashboard is
# Poseidon(strategyParams[0..7], salt) — see src/policy.ts.
# Format: comma-separated integers.
STRATEGY_PARAMS=10,0,0,0,0,0,0,0

# Salt bound into the strategy commitment (same value used at
# registration; keep it stable for the whole tournament)
STRATEGY_SALT=999
